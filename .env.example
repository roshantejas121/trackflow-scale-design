# Legacy/single-database fallback. PRIMARY_DB_URL takes precedence when set.
DATABASE_URL=postgres://user:password@localhost:5432/trackflow

# Production write endpoint. If omitted, DATABASE_URL is used.
PRIMARY_DB_URL=postgres://user:password@localhost:5432/trackflow

# Optional read-replica endpoint. If omitted, PRIMARY_DB_URL is used for local testing.
REPLICA_DB_URL=postgres://user:password@localhost:5432/trackflow

PORT=3000
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
